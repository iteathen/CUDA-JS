  "sideEffects": false,
  "engines": {
    "node": ">=26.1.0"
  },
  "exports": {
    ".": {
      "types": "./components/runtime-facade/index.d.ts",
      "import": "./components/runtime-facade/index.mjs"
    },
    "./compatibility": {
      "types": "./components/runtime-facade/compatibility.d.ts",
      "import": "./components/runtime-facade/compatibility.mjs"
